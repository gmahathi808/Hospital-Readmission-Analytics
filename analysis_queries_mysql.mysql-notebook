    "caption": "DB Notebook 3",
    "content": "\\about\nSELECT\n    COUNT(*)                                  AS total_visits,\n    COUNT(DISTINCT patient_nbr)               AS unique_patients,\n    SUM(readmitted_30d)                       AS readmissions_30d,\n    ROUND(100 * AVG(readmitted_30d), 2)       AS readmit_rate_pct,\n    ROUND(AVG(time_in_hospital), 2)           AS avg_length_of_stay,\n    SUM(readmitted_30d) * 15200               AS est_cost_usd\nFROM encounters;\n\nWITH baseline AS (\n    SELECT AVG(readmitted_30d) AS overall_rate\n    FROM encounters\n)\nSELECT\n    e.discharge_group,\n    COUNT(*)                                               AS visits,\n    ROUND(100 * AVG(e.readmitted_30d), 2)                  AS readmit_rate_pct,\n    ROUND(AVG(e.readmitted_30d) / MAX(b.overall_rate), 2)  AS lift_vs_average\nFROM encounters e\nCROSS JOIN baseline b\nGROUP BY e.discharge_group\nHAVING COUNT(*) >= 100\nORDER BY lift_vs_average DESC;\n\nSELECT\n    prior_inpatient_band,\n    COUNT(*)                                                              AS visits,\n    ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (), 2)                      AS pct_of_visits,\n    SUM(readmitted_30d)                                                   AS readmissions,\n    ROUND(100 * SUM(readmitted_30d) / SUM(SUM(readmitted_30d)) OVER (), 2) AS pct_of_readmissions,\n    ROUND(100 * AVG(readmitted_30d), 2)                                   AS readmit_rate_pct\nFROM encounters\nGROUP BY prior_inpatient_band\nORDER BY prior_inpatient_band;\n\nWITH patient_visits AS (\n    SELECT\n        patient_nbr,\n        readmitted_30d,\n        COUNT(*) OVER (PARTITION BY patient_nbr) AS visits_per_patient\n    FROM encounters\n)\nSELECT\n    CASE WHEN visits_per_patient >= 3 THEN '3+ visits'\n         WHEN visits_per_patient = 2  THEN '2 visits'\n         ELSE '1 visit' END                                          AS patient_segment,\n    COUNT(DISTINCT patient_nbr)                                      AS patients,\n    SUM(readmitted_30d)                                              AS readmissions,\n    ROUND(100 * COUNT(DISTINCT patient_nbr) /\n          (SELECT COUNT(DISTINCT patient_nbr) FROM encounters), 2)   AS pct_of_patients,\n    ROUND(100 * SUM(readmitted_30d) /\n          (SELECT SUM(readmitted_30d) FROM encounters), 2)           AS pct_of_readmissions\nFROM patient_visits\nGROUP BY patient_segment\nORDER BY patient_segment;\n\n-- Q5. Does readmission risk grow with each return visit? (LAG)\nWITH ordered AS (\n    SELECT\n        encounter_seq,\n        readmitted_30d,\n        LAG(readmitted_30d) OVER (PARTITION BY patient_nbr ORDER BY encounter_id) AS prev_readmitted\n    FROM encounters\n)\nSELECT\n    CASE WHEN encounter_seq >= 4 THEN '4+' ELSE CAST(encounter_seq AS CHAR) END AS visit_number,\n    CASE WHEN prev_readmitted IS NULL THEN 'First visit'\n         WHEN prev_readmitted = 1     THEN 'Previous visit: readmitted'\n         ELSE 'Previous visit: not readmitted' END                           AS previous_visit,\n    COUNT(*)                                AS visits,\n    ROUND(100 * AVG(readmitted_30d), 2)     AS readmit_rate_pct\nFROM ordered\nGROUP BY visit_number, previous_visit\nORDER BY visit_number, previous_visit;\n\n-- Q6. Rank primary diagnoses by readmission risk (RANK)\nSELECT\n    primary_diagnosis,\n    COUNT(*)                                AS visits,\n    ROUND(100 * AVG(readmitted_30d), 2)     AS readmit_rate_pct,\n    ROUND(AVG(time_in_hospital), 2)         AS avg_stay_days,\n    RANK() OVER (ORDER BY AVG(readmitted_30d) DESC) AS risk_rank\nFROM encounters\nGROUP BY primary_diagnosis\nHAVING COUNT(*) >= 100\nORDER BY risk_rank;\n\n-- Q7. Pivot: readmission rate by age group and prior admissions (CASE WHEN pivot)\nSELECT\n    CASE WHEN age_years < 50 THEN '<50'\n         WHEN age_years < 70 THEN '50-69'\n         ELSE '70+' END                                                                    AS age_group,\n    ROUND(100 * AVG(CASE WHEN prior_inpatient_band = '0'  THEN readmitted_30d END), 2)    AS prior_0_pct,\n    ROUND(100 * AVG(CASE WHEN prior_inpatient_band = '1'  THEN readmitted_30d END), 2)    AS prior_1_pct,\n    ROUND(100 * AVG(CASE WHEN prior_inpatient_band = '2'  THEN readmitted_30d END), 2)    AS prior_2_pct,\n    ROUND(100 * AVG(CASE WHEN prior_inpatient_band = '3+' THEN readmitted_30d END), 2)    AS prior_3plus_pct,\n    COUNT(*)                                                                               AS visits\nFROM encounters\nGROUP BY age_group\nORDER BY MIN(age_years);\n\n-- Q8. HbA1c testing and treatment vs readmission\nSELECT\n    hba1c_management,\n    COUNT(*)                                            AS visits,\n    ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (), 2)    AS pct_of_visits,\n    ROUND(100 * AVG(readmitted_30d), 2)                 AS readmit_rate_pct\nFROM encounters\nGROUP BY hba1c_management\nORDER BY hba1c_management;\n\n-- Q9. Rule-based high-risk segment: 2+ prior admissions OR discharged to nursing/rehab\nWITH flagged AS (\n    SELECT\n        readmitted_30d,\n        CASE WHEN number_inpatient >= 2\n               OR discharge_group IN ('Skilled nursing facility', 'Rehab / long-term care')\n             THEN 1 ELSE 0 END AS high_risk_rule\n    FROM encounters\n)\nSELECT\n    CASE WHEN high_risk_rule = 1 THEN 'Flagged high risk' ELSE 'Not flagged' END   AS segment,\n    COUNT(*)                                                                        AS visits,\n    ROUND(100 * COUNT(*) / SUM(COUNT(*)) OVER (), 2)                                AS pct_of_visits,\n    ROUND(100 * SUM(readmitted_30d) / SUM(SUM(readmitted_30d)) OVER (), 2)          AS pct_of_readmissions,\n    ROUND(100 * AVG(readmitted_30d), 2)                                             AS readmit_rate_pct\nFROM flagged\nGROUP BY segment\nORDER BY segment;\n\n",
